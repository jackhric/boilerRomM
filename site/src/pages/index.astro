---
import "@/styles/starwind.css";
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/theme.css';
import Emulators from '../components/Emulators.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Seo from '../components/Seo.astro';
import Statistics from '../components/Statistics.astro';
import Status from '../components/Status.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/jackhric/boilerRomM';
const title = 'boilerRomM: your RomM library, as a store in Steam';
const description = 'A Decky Loader plugin that turns your RomM server into a store inside Steam Game Mode. Download a game and it appears in your Steam library, with its emulator installed and configured for you.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
    <Statistics />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <Hero repo={repo} />

    <main>
      <HowItWorks />
      <Features />
      <Emulators />
      <Status />
    </main>

    <Footer repo={repo} />
  </body>
</html>

<style is:global>
  @layer base {
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scrollbar-gutter: stable; }
    body {
      margin: 0; background: var(--background); color: var(--foreground);
      font: 16px/1.6 'Plus Jakarta Sans Variable', system-ui, -apple-system, 'Segoe UI', Roboto, Ubuntu, sans-serif;
    }
    a { color: var(--foreground); text-underline-offset: 3px; }
    a[data-slot] { text-decoration: none; }
    img { max-width: 100%; height: auto; }
    h2 {
      font: 600 clamp(1.4rem, 2.8vw, 1.95rem)/1.2 var(--display); text-align: center; margin: 0 0 28px;
      letter-spacing: -0.02em; text-wrap: balance;
    }
  }

  main { max-width: 1040px; margin: 0 auto; padding-inline: 20px; }
</style>
