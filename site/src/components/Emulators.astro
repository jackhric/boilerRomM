---
import { emulators } from '../data/emulators';
import Shot from './Shot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="emulators" class="emulators" aria-labelledby="emulators-title">
  <h2 id="emulators-title">Nine emulators, one Install button</h2>
  <p class="intro">
    Every system in your library gets an emulator. Setup installs them all, oldest console first, and fetches each
    one's firmware from your RomM server as it goes. Builds come from each project's own releases.
  </p>
  <div class="layout">
    <ul class="rows">
      {emulators.map(e => (
        <li>
          <span class="name">{e.name}</span>
          <span class="systems">{e.systems}</span>
          <span class:list={['fw', { none: !e.firmware }]}>{e.firmware ?? 'No firmware needed'}</span>
        </li>
      ))}
    </ul>
    <div class="side">
      <Shot name="emulators" alt="Settings > Emulators: each emulator with its installed version in a drop-down and a menu for Reinstall, Reset and Uninstall" sizes="(max-width: 900px) 100vw, 480px" />
      <p class="note">
        Change an emulator's version, reinstall it or reset its settings from Settings &gt; Emulators. Firmware has its
        own page, BIOS Files. <a href={`${base}/docs/guides/emulators/`}>How emulators and firmware work</a>
      </p>
    </div>
  </div>
</section>

<style>
  .emulators { padding-block: 40px 56px; }
  .intro { max-width: 62ch; margin: -12px auto 32px; text-align: center; color: var(--muted-foreground); }
  .layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .rows li {
    display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 2px 16px; padding: 12px 16px;
    background: var(--card); border: 1px solid var(--border); border-radius: 8px;
  }
  .name { grid-row: span 2; font: 600 1rem/1.4 var(--display); }
  .systems { font-size: 0.93rem; }
  .fw { font-size: 0.85rem; color: var(--muted-foreground); }
  .fw::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: var(--primary); vertical-align: 1px; }
  .fw.none::before { background: var(--border); }
  .side { position: sticky; top: 24px; display: grid; gap: 14px; }
  .note { margin: 0; font-size: 0.92rem; color: var(--muted-foreground); }
  .note a { color: var(--foreground); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
  }
  @media (max-width: 520px) {
    .rows li { grid-template-columns: minmax(0, 1fr); }
    .name { grid-row: auto; }
  }
</style>
