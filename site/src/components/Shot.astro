---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// A screenshot slot: drop src/assets/shots/<slot>.webp (or run `pnpm run shots`) and every page using the slot picks it
// up. A slot with no file yet renders a labelled empty frame, so the layout can be reviewed before the capture exists.
const files = import.meta.glob<ImageMetadata>('../assets/shots/*.{webp,jpg,png}', { import: 'default', eager: true });
const bySlot = new Map(Object.entries(files).map(([path, img]) => [/([^/]+)\.\w+$/.exec(path)![1], img]));

interface Props { name: string; alt: string; class?: string; eager?: boolean; sizes?: string }
// `name`, not `slot`: Astro reserves a `slot` attribute for placing a component in a parent's named slot.
const { name: slot, alt, class: className, eager = false, sizes = '(max-width: 1100px) 100vw, 1040px' } = Astro.props;
const img = bySlot.get(slot);
---

<figure class:list={['shot', className]} data-slot-name={slot}>
  {img ? (
    <Image src={img} alt={alt} widths={[640, 960, 1600].filter(w => w <= img.width)} sizes={sizes}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  ) : (
    <div class="empty" role="img" aria-label={alt}>
      <span>Screenshot to come</span>
      <small>{alt}</small>
    </div>
  )}
</figure>

<style>
  .shot {
    margin: 0; border-radius: 12px; overflow: hidden; background: var(--frame-bg);
    border: 1px solid var(--frame-border); box-shadow: 0 24px 60px -18px var(--frame-shadow);
    aspect-ratio: 2 / 1;
  }
  .shot :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .empty {
    height: 100%; display: grid; place-content: center; gap: 6px; padding: 24px; text-align: center;
    color: #9aa1a9; background: repeating-linear-gradient(135deg, #171d25 0 14px, #1b222b 14px 28px);
  }
  .empty span { font: 600 1rem/1.2 var(--display); color: #d6d9dc; }
  .empty small { font-size: 0.85rem; max-width: 36ch; }
</style>
