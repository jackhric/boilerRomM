---
import pkg from '../../../package.json';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const repo = 'https://github.com/jackhric/boilerRomM';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.jpg`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'boilerRomM', url: canonical },
    {
      '@type': 'SoftwareSourceCode',
      name: 'boilerRomM',
      codeRepository: repo,
      programmingLanguage: ['TypeScript', 'Python'],
      license: `${repo}/blob/main/LICENSE`,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'boilerRomM',
      description,
      url: canonical,
      image,
      applicationCategory: 'GameApplication',
      applicationSubCategory: 'Decky Loader plugin',
      operatingSystem: 'SteamOS, Bazzite (Decky Loader)',
      softwareVersion: pkg.version,
      license: `${repo}/blob/main/LICENSE`,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      sameAs: [repo],
      author: { '@type': 'Person', name: 'Jack Hric', url: 'https://jackhric.com' },
      keywords: 'RomM, Decky Loader plugin, Steam Deck, SteamOS, Bazzite, Game Mode, emulation frontend, RetroArch, PCSX2, Dolphin, RPCS3, Cemu, Xenia, shadPS4, SteamGridDB, self-hosted game library',
      featureList: [
        "Browse a RomM library in a store inside Steam's Game Mode, with artwork and trailers",
        'Downloaded games become Steam library entries with artwork, Storage and Uninstall',
        "Downloads show on Steam's Downloads page and resume after a restart",
        'Installs and configures nine emulators, with firmware fetched from your own RomM server',
        "Pairs with RomM using RomM's device code sign-in, with no password typed on the device",
      ],
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="boilerRomM" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="boilerRomM: your RomM library, as a store in Steam" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
