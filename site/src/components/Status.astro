---
const working = [
  'The store, game pages, search and filters, with artwork and trailers',
  'First-run setup: server, pairing from your phone, SteamGridDB sign-in',
  "Downloads on Steam's Downloads page, in Settings > Storage, with Uninstall",
  'Installing all nine emulators and their firmware from your RomM server',
];
const notYet = [
  'Most emulators have not launched a real game through boilerRomM yet',
  'Controller mapping is not set up per emulator',
  'Emulators do not update themselves; you pick a newer version by hand',
  'There is no release and no Decky store listing yet',
];
---

<section id="status" class="status" aria-labelledby="status-title">
  <h2 id="status-title">Where it stands</h2>
  <div class="cols">
    <div class="col">
      <h3>Working on a device today</h3>
      <ul>{working.map(w => <li class="yes">{w}</li>)}</ul>
    </div>
    <div class="col">
      <h3>Not done yet</h3>
      <ul>{notYet.map(w => <li class="no">{w}</li>)}</ul>
    </div>
  </div>
  <p class="legal">
    <strong>Bring your own games.</strong> boilerRomM comes with no games, BIOS, firmware or keys. It works with the
    RomM server you run and the files you have put on it.
  </p>
</section>

<style>
  .status { padding-block: 40px 48px; }
  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .col { padding: 22px 24px; border-radius: 16px; background: var(--card); border: 1px solid var(--border); }
  h3 { margin: 0 0 12px; font: 600 1.05rem/1.3 var(--display); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  li { position: relative; padding-left: 28px; color: var(--muted-foreground); line-height: 1.45; }
  li::before {
    position: absolute; left: 0; top: 0.1em; width: 18px; height: 18px; border-radius: 50%; display: grid;
    place-items: center; font-size: 0.7rem; font-weight: 800;
  }
  .yes::before { content: '✓'; background: color-mix(in srgb, var(--success) 22%, transparent); color: var(--success); }
  .no::before { content: '–'; background: var(--secondary); color: var(--muted-foreground); }
  .legal {
    margin: 16px 0 0; padding: 16px 20px; border-radius: 12px; font-size: 0.95rem; color: var(--muted-foreground);
    border: 1px dashed var(--border);
  }
  .legal strong { color: var(--foreground); }
  @media (max-width: 720px) { .cols { grid-template-columns: minmax(0, 1fr); } }
</style>
