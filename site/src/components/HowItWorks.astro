---
import Shot from './Shot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
  {
    slot: 'setup',
    title: 'Set it up once',
    text: 'Enter your RomM address, approve the device from your phone, sign in to SteamGridDB for artwork, then press Install all. About five minutes.',
    alt: "First-run setup installing the emulators one after another, with RPCS3 installing its firmware",
    href: `${base}/docs/setup/`,
  },
  {
    slot: 'browse',
    title: 'Browse your own server',
    text: 'Discover, Browse, Top rated, New and Consoles, with search and filters. Box art comes from SteamGridDB; trailers play muted in the spotlight and on each game page.',
    alt: 'The Browse page: a grid of box art for 184 games with console and genre filters',
    href: `${base}/docs/guides/store/`,
  },
  {
    slot: 'downloads',
    title: 'Download like a Steam game',
    text: "Downloads run one at a time and show on the game, in the store and on Steam's own Downloads page. One cut off by a restart carries on by itself.",
    alt: "Steam's Downloads page with a boilerRomM game downloading",
    href: `${base}/docs/guides/store/#downloads`,
  },
  {
    slot: 'storage',
    title: 'Play it from your library',
    text: 'Each game is a Steam shortcut with its artwork. It launches in its emulator, appears in Settings > Storage with its size, and has Uninstall in its menu.',
    alt: "Steam's Storage settings listing boilerRomM games by size",
    href: `${base}/docs/guides/store/#in-your-steam-library`,
  },
];
---

<section id="how" class="how" aria-labelledby="how-title">
  <h2 id="how-title">From your server to your Steam library</h2>
  <div class="layout" data-steps>
    <ol class="steps" role="tablist" aria-orientation="vertical">
      {steps.map((s, i) => (
        <li role="presentation">
          <button role="tab" id={`step-${s.slot}`} aria-controls={`panel-${s.slot}`} aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}>
            <b>{i + 1}</b>
            <span class="t">{s.title}</span>
            <span class="d">{s.text}</span>
          </button>
          <a class="more" href={s.href}>Read more</a>
        </li>
      ))}
    </ol>
    <div class="panels">
      {steps.map((s, i) => (
        <div role="tabpanel" id={`panel-${s.slot}`} aria-labelledby={`step-${s.slot}`} hidden={i !== 0}>
          <Shot name={s.slot} alt={s.alt} sizes="(max-width: 900px) 100vw, 620px" />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-steps]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', e => {
        const step = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });
  }
</script>

<style>
  .how { padding-block: 64px 32px; }
  .layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr); gap: 32px; align-items: start; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .steps li { position: relative; }
  button {
    display: grid; grid-template-columns: 28px 1fr; gap: 2px 12px; width: 100%; padding: 14px 16px 14px 14px;
    text-align: left; border: 1px solid transparent; border-radius: 12px; background: none;
  }
  button:hover { background: var(--muted); }
  button[aria-selected='true'] { background: var(--card); border-color: var(--border); }
  button:focus-visible { outline: 2px solid var(--outline); outline-offset: 2px; }
  b {
    grid-row: span 2; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
    font-size: 0.8rem; background: var(--secondary); color: var(--muted-foreground);
  }
  [aria-selected='true'] b { background: var(--primary); color: var(--primary-foreground); }
  .t { font: 600 1.08rem/1.3 var(--display); }
  .d { display: none; color: var(--muted-foreground); font-size: 0.93rem; line-height: 1.55; margin-top: 4px; }
  [aria-selected='true'] .d { display: block; }
  .more { display: none; position: absolute; right: 16px; top: 16px; font-size: 0.85rem; color: var(--muted-foreground); }
  li:has([aria-selected='true']) .more { display: block; }
  .panels { position: sticky; top: 24px; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .panels { position: static; order: -1; }
  }
</style>
