#!/bin/bash
# Steam shortcut launcher: boilerromm-launch <game id>. Runs the script the plugin wrote for that game, which holds
# the emulator's command line. The shortcut itself never changes when the emulator or the ROM folder does.
set -u
id="${1:-}"
if [[ ! "$id" =~ ^[0-9]+$ ]]; then echo "usage: boilerromm-launch <game id>" >&2; exit 2; fi
script="$(dirname "$(readlink -f "$0")")/launch/$id.sh"
if [[ ! -x "$script" ]]; then echo "boilerRomM: nothing to launch for game $id; open boilerRomM once" >&2; exit 1; fi
exec "$script"
